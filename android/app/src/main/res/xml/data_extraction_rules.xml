<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ ignores android:allowBackup for device-to-device transfer, so the
  saved host store, identities and preferences are excluded explicitly. Nothing
  in this app is backed up: hosts carry SSH endpoints and the identity store is
  the device key.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
