<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#E5AC55</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#101216</item>
        <item name="android:statusBarColor">#101216</item>
        <item name="android:navigationBarColor">#101216</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <!-- The GPUI host list and terminal only. DeviceDefault is the platform's
         current design on each device, so their dialogs, menus and controls
         match it instead of the 2014 Material theme; the terminal recolors its
         own chrome from the palette. -->
    <style name="GpuiTheme" parent="android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#E5AC55</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#101216</item>
        <item name="android:statusBarColor">#101216</item>
        <item name="android:navigationBarColor">#101216</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <!-- The bundled About pages: light or dark with the system setting, as
         their stylesheet is, laid out edge to edge under transparent bars. -->
    <style name="AboutTheme" parent="android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
