<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <!-- Back reaches each screen through OnBackInvokedCallback (BackOwner) on
         Android 13 and later, as Android 16 requires for every app targeting it. -->
    <application android:label="Remote for Herdr" android:theme="@style/AppTheme"
        android:icon="@mipmap/ic_launcher" android:allowBackup="false"
        android:enableOnBackInvokedCallback="true" tools:targetApi="33"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        tools:ignore="DataExtractionRules"
        android:usesCleartextTraffic="false" android:hardwareAccelerated="true"
        android:supportsRtl="true">
        <!-- The device's fold reports (tabletop posture); absent on most phones. -->
        <uses-library android:name="androidx.window.extensions" android:required="false" />
        <activity android:name="dev.herdr.android.RemoteHostsActivity" android:exported="true"
            android:theme="@style/GpuiTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="dev.herdr.android.DeviceDiagnosticsActivity" android:exported="false" />
        <activity android:name="dev.herdr.android.AboutActivity" android:exported="false"
            android:theme="@style/AboutTheme" />
        <activity android:name="dev.herdr.android.MainActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name="dev.herdr.android.GpuiTerminalActivity" android:exported="false"
            android:theme="@style/GpuiTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="herdr_gpui_android" />
        </activity>
    </application>
</manifest>
